# ── Copy to .env and fill in for TESTNET (Sepolia) deploys ──────────────
# Never commit your real .env. Never put a real-money key here.

# RPC endpoint for Sepolia (Alchemy/Infura/public). Example:
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private key of the wallet that deploys + acts as the house/owner.
# Use a THROWAWAY test wallet only. (This is the key for 0x2F4B…aB39 if that's
# the wallet you deploy with — export it from MetaMask: Account details →
# Show private key.) NEVER use a wallet that holds real funds.
PRIVATE_KEY=

# Optional off-chain bridge signer for server-authoritative games such as Blackjack.
# Leave disabled unless you are deliberately testing the bridge flow.
# Generate with: node server/realmoney.js --genkey
HOUSE_SIGNER_KEY=
ENABLE_EXPERIMENTAL_BRIDGE=0
BRIDGE_ETH_USD=3400
# Required before ENABLE_EXPERIMENTAL_BRIDGE=1. Must point to durable storage
# so used buy-in tx hashes and open sessions survive server restarts.
BRIDGE_STATE_FILE=

# Where the 3% fee + house bankroll live (the "host" = you).
# Defaults to 0x2F4BEF94550C29c497b999B86b758F9771F7aB39 if left blank.
TREASURY_ADDRESS=0x2F4BEF94550C29c497b999B86b758F9771F7aB39

# Chainlink VRF v2.5 subscription you created at https://vrf.chain.link
# (fund it with test LINK, then add the deployed contract as a consumer).
SUBSCRIPTION_ID=

# Optional overrides (sensible Sepolia defaults are built in):
# VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae

# How much ETH to pre-load into the house bankroll on deploy (default 5).
HOUSE_FUND=5
